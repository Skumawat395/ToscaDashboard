// ==============================================
// RISE - QM
// ==============================================

JumpToNode "/Execution/ExecutionLists/RISE_INDIA/2_Review/QM_RISE_QA_SeparateExeList"

// Get Environment
cn ..
cn ..
get Name

// Go back to QM ExecutionList
JumpToNode "/Execution/ExecutionLists/RISE_INDIA/2_Review/QM_RISE_QA_SeparateExeList"

// Get Module
get Name

// Fetch TestCase Results
For "=>SUBPARTS:ExecutionEntry" CallOnEach "ToscaScripts\\GetIndividualResult.tcs"


