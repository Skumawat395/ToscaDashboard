# Copy this file to data.env (git-ignored) and fill in every value.
DASHBOARD_USERNAME=your-team-username
DASHBOARD_PASSWORD=replace-with-a-strong-password
# Optional: set a stable random value to keep sessions valid across restarts.
FLASK_SECRET_KEY=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-server-side-secret-key
TOSCA_SQLITE_FILE=
# Where the dashboard reads results: auto (Supabase, fall back to local), supabase, local
RESULTS_SOURCE=auto
# Minutes without any test case running that separate two executions (reports)
RUN_GAP_MINUTES=60

# Tosca TCShell settings used by tosca
un_tcshell.bat
TOSCA_TCSHELL=C:\Program Files (x86)\TRICENTIS\Tosca Testsuite\ToscaCommander\TCShell.exe
TOSCA_WORKSPACE=C:\path\to\your\workspace.tws
TOSCA_AUTH=base64-client-credentials-from-tosca
