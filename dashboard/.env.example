# Copy this file to data\.env (git-ignored) and fill in every value.
DASHBOARD_USERNAME=your-team-username
DASHBOARD_PASSWORD=replace-with-a-strong-password
# Optional: set a stable random value to keep sessions valid across restarts.
FLASK_SECRET_KEY=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-server-side-secret-key
TOSCA_SQLITE_FILE=
# Where the dashboard reads results: auto (Supabase, fall back to local), supabase, local
RESULTS_SOURCE=auto
# Minutes without any test case running that separate two executions (reports)
RUN_GAP_MINUTES=60

# ---- Web server ---------------------------------------------------------
# 127.0.0.1 = only this machine (also right when IIS on this machine forwards to it).
# 0.0.0.0   = reachable from other machines (when IIS on another server forwards to it).
HOST=127.0.0.1
PORT=5000
# Sub-path the dashboard is served under. Empty = served at /.
# For https://ondemandqa.com/automationreports use /automationreports
URL_PREFIX=
# 1 when people open the dashboard over https
SESSION_COOKIE_SECURE=
# The link people use; printed by Execute.bat / Setup_Dashboard_VM.bat and opened after an import.
DASHBOARD_URL=http://127.0.0.1:5000
# Tosca PC only: "no" when the dashboard runs on the VM (Execute.bat then skips starting a local server).
START_LOCAL_DASHBOARD=yes

# ---- Tosca TCShell (Tosca PC only), used by tosca\run_tcshell.bat ------
TOSCA_TCSHELL=C:\Program Files (x86)\TRICENTIS\Tosca Testsuite\ToscaCommander\TCShell.exe
TOSCA_WORKSPACE=C:\path\to\your\workspace.tws
TOSCA_AUTH=base64-client-credentials-from-tosca
